# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/go237db?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:8081

# Payment APIs
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-site-id
MOMO_API_KEY=your-mtn-momo-api-key
MOMO_SUBSCRIPTION_KEY=your-subscription-key
ORANGE_MONEY_API_KEY=your-orange-money-key

# SMS
SMS_API_KEY=your-sms-provider-key

# Maps
OPENSTREETMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
