# Server
PORT=3002
NODE_ENV=development

# URL publique de l'API (utilisée pour les webhooks de paiement et les URLs d'upload)
API_BASE_URL=http://localhost:3002

# Database (injectée automatiquement par Railway en production)
DATABASE_URL="postgresql://user:password@localhost:5432/go237db?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Socket.IO (origine autorisée : URL de l'admin en production)
SOCKET_CORS_ORIGIN=*

# ===== Paiement =====
# CinetPay (passerelle universelle)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# MTN Mobile Money
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox

# Orange Money
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# ===== SMS =====
# Fournisseur : africas_talking (défaut) ou infobip
SMS_PROVIDER=africas_talking
SMS_API_KEY=
SMS_SENDER_ID=237GO
AFRICAS_TALKING_USERNAME=sandbox
# Pour Infobip uniquement :
INFOBIP_BASE_URL=

# ===== Uploads =====
# Chemin de stockage des fichiers téléversés.
# En production, pointer vers un volume persistant (ex: /data/uploads sur Railway).
# Laisser vide en local (utilise ./uploads par défaut).
UPLOAD_PATH=

# ===== Intelligence Artificielle =====
# Fournisseur : claude (défaut, Anthropic) ou openai
AI_PROVIDER=claude
AI_API_KEY=
# Modèle optionnel (défaut: claude-3-5-sonnet-20241022 ou gpt-4o-mini)
AI_MODEL=

# Maps
OPENSTREETMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
