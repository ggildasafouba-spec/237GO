{
  "expo": {
    "name": "237GO",
    "slug": "237go",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5343324b-5143-4bc9-8384-d2950a4f900b",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121A17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.go237.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "237GO a besoin de votre position pour vous trouver un chauffeur à proximité."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121A17"
      },
      "package": "com.go237.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "237GO",
      "shortName": "237GO",
      "themeColor": "#1DB954",
      "backgroundColor": "#121A17",
      "display": "standalone",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "237GO a besoin de votre position pour vous trouver un chauffeur à proximité.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "237GO a besoin d'accéder à vos photos pour envoyer une photo de profil, de produit ou un document.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "ggildas",
    "extra": {
      "eas": {
        "projectId": "5343324b-5143-4bc9-8384-d2950a4f900b"
      }
    }
  }
}
